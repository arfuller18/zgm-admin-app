// ZGM Admin — production management data model.
// Source of truth going forward; seeded from and kept in sync with the
// Zero Gravity Media Airtable base (app1C5WNULP6I61dM).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth ----------

enum Role {
  ADMIN
  EXECUTIVE
  PRODUCER_PM
  DEPARTMENT_LEAD
  CREW_STAFF
  FINANCE
  VENDOR_EXTERNAL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CREW_STAFF)
  active        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  createdBookings Booking[] @relation("BookingCreatedBy")

  createdVariations  ScheduleVariation[] @relation("VariationCreatedBy")
  masterPublications MasterPublication[] @relation("PublishedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core production entities ----------

enum ProjectFormat {
  SERIES
  FEATURE
  LIMITED_SERIES
  UNSCRIPTED
  DOCUMENTARY
  CO_PRO
  SHORT_DIGITAL
  OTHER
}

enum ProjectStatus {
  IDEA
  SUBMISSION
  OPTIONED
  SCRIPT
  PACKAGING
  FINANCING
  GREENLIGHT_READY
  PREP
  PAUSED
  WRAPPED
  ARCHIVED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
  WATCH
}

// Mirrors Project Hub's "Project Color" single-select — drives the bright,
// per-project color coding used across cards, badges, and the calendar.
enum ProjectColor {
  PINK
  PURPLE
  BLUE
  GREEN
  YELLOW
  ORANGE
  RED
}

model Project {
  id         String  @id @default(cuid())
  airtableId String? @unique

  name        String
  projectCode String? @unique

  format                  ProjectFormat?
  seasonFilm              String?
  episodeCount            Int?
  episodeLength           Int? // minutes
  currentStatus           ProjectStatus?
  priority                Priority?
  zgmOwner                String?
  rightsStatus            String?
  rightsExpiration        DateTime?
  scriptStatus            String?
  salesDistributionStatus String?
  salesDistributionNotes  String?        @db.Text
  genre                   String?
  projectColor            ProjectColor?
  mainContactRole         String?

  googleFolderUrl String?
  decksBiblesUrl  String?
  castingStatus   String?
  castingDirector String?
  additionalLinks String?

  logline         String? @db.Text
  whyZgm          String? @db.Text
  audienceHook    String? @db.Text
  biggestRisk     String? @db.Text
  additionalNotes String? @db.Text
  taxCreditNotes  String? @db.Text

  nextDecision      String?
  nextAction        String?
  nextActionDueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitProductions UnitProduction[]
  schedulePhases  ProductionSchedulePhase[]
  shootDays       ShootDay[]
  bookings        Booking[]
  contacts        ProjectContact[]
  budgets         Budget[]
  tasks           Task[]

  schedulingRequirements SchedulingRequirement[]
  scheduleAssignments    ScheduleAssignment[]
  workCalendarExceptions WorkCalendarException[]

  @@index([currentStatus])
  @@index([priority])
}

enum BudgetStatus {
  DRAFT
  FINAL
}

// Mirrors Airtable's Budget Lists table — a project can carry several
// budget versions (e.g. a draft and a final) rather than one flat number.
model Budget {
  id         String  @id @default(cuid())
  airtableId String? @unique

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name             String
  totalBudget      Decimal?      @db.Decimal(14, 2)
  budgetPerEpisode Decimal?      @db.Decimal(14, 2)
  status           BudgetStatus?
  budgetSheetsLink String?
  notes            String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

enum ProjectContactRelation {
  EXECUTIVE_OWNER
  DAY_TO_DAY_OWNER
  SHOWRUNNER
  KEY_TALENT
  KEY_CREW
  IMPORTANT_CONTACT
}

// Generic join covering Project Hub's several Contact-List link fields
// (Executive Owner, Day-to-Day Owner, Showrunner, Key Talent, Key Crew,
// Important Contacts) without a separate table per relation.
model ProjectContact {
  id        String                 @id @default(cuid())
  projectId String
  personId  String
  relation  ProjectContactRelation
  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person    Person                 @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([projectId, personId, relation])
}

model UnitProduction {
  id         String  @id @default(cuid())
  airtableId String? @unique

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name         String
  season       Int?
  episode      Int?
  episodeTitle String?
  scriptStatus String?
  duration     Int?

  bookedBy      String? @db.Text
  bookingWindow String? @db.Text
  notes         String? @db.Text

  // DEPRECATED — superseded by ScheduleAssignment. Dates are a property of
  // a placement within a variation, not of the unit's identity, so a unit
  // cannot carry one pair of dates once it can appear in several schedules.
  // Never populated in practice (0 of 50 rows). Kept for one release; the
  // unit edit form no longer writes them. Dropped in a later migration.
  startDate DateTime? // Airtable "Production Calendar"
  endDate   DateTime?

  // Unit Productions have no Airtable status field to reuse (unlike
  // Project, which gained WRAPPED/ARCHIVED as real ProjectStatus values) —
  // this is purely an app-side hide-from-default-views flag.
  archived Boolean @default(false)

  directorId String?
  director   Person? @relation("Director", fields: [directorId], references: [id])
  writerId   String?
  writer     Person? @relation("Writer", fields: [writerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedulePhases ProductionSchedulePhase[] @relation("SchedulePhaseUnits")
  shootDays      ShootDay[]
  locations      Location[]                @relation("UnitProductionLocations")
  bookings       Booking[]
  tasks          Task[]

  schedulingRequirements SchedulingRequirement[]

  @@index([projectId])
}

model ProductionSchedulePhase {
  id         String  @id @default(cuid())
  airtableId String? @unique

  scheduleCode String? @unique // "SCH-001"

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  phase        String
  startDate    DateTime?
  endDate      DateTime?
  workDays     Int?
  calendarDays Int?
  location     String?
  notes        String?   @db.Text
  status       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitProductions UnitProduction[] @relation("SchedulePhaseUnits")
  shootDays       ShootDay[]

  @@index([projectId])
  @@index([startDate, endDate])
}

model ShootDay {
  id         String  @id @default(cuid())
  airtableId String? @unique

  shootDayCode String?   @unique // "DAY-0001"
  date         DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  unitProductionId String?
  unitProduction   UnitProduction? @relation(fields: [unitProductionId], references: [id])

  // DEPRECATED — superseded by scheduleAssignmentId. Kept populated for one
  // release so the legacy table stays reconcilable.
  parentScheduleId String?
  parentSchedule   ProductionSchedulePhase? @relation(fields: [parentScheduleId], references: [id])

  // A shoot day belongs to an assignment, and an assignment belongs to a
  // variation — so day-level scheduling works inside any variation without
  // first pushing to Master. Days are materialised for Master on publish and
  // on demand elsewhere; the model imposes no such restriction.
  // SetNull, emphatically not Cascade. Unscheduling a block must not destroy
  // its days: a shoot day carries real content (planning notes, location,
  // status) that a planner would not expect to lose by moving something out
  // of a schedule. The day survives, attached to its project and unit, and
  // can be re-linked or cleaned up deliberately.
  scheduleAssignmentId String?
  scheduleAssignment   ScheduleAssignment? @relation(fields: [scheduleAssignmentId], references: [id], onDelete: SetNull)

  seasonShootDay Int?
  episodeDay     Int?
  // DEPRECATED — derived from `date` at read time. A stored copy can drift.
  dayOfWeek      String?
  // Legacy free-text location, retained while locationId is backfilled.
  location       String?
  planningNote   String? @db.Text

  locationId  String?
  locationRef Location? @relation("ShootDayLocation", fields: [locationId], references: [id], onDelete: SetNull)

  status    ShootDayStatus @default(PLANNED)
  sortOrder Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([date])
  // Missing until now — this is the column the per-unit schedule filter
  // queries on.
  @@index([unitProductionId])
  @@index([scheduleAssignmentId])
  @@index([date, projectId])
}

enum ShootDayStatus {
  PLANNED
  CONFIRMED
  SHOT
  CANCELLED
}

model Location {
  id         String  @id @default(cuid())
  airtableId String? @unique

  name              String
  address           String?
  locationType      String[]
  agreementStatus   String?
  nearestHospital   String?  @db.Text
  cellService       Boolean?
  wifiAvailable     Boolean?
  parkingNotes      String?  @db.Text
  accessNotes       String?  @db.Text
  availabilityNotes String?  @db.Text
  locationFee       Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitProductions UnitProduction[] @relation("UnitProductionLocations")
  bookings        Booking[]

  scheduleAssignments ScheduleAssignment[]
  shootDays           ShootDay[]           @relation("ShootDayLocation")
}

model Equipment {
  id       String  @id @default(cuid())
  name     String
  category String?
  notes    String? @db.Text
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

model Person {
  id         String  @id @default(cuid())
  airtableId String? @unique

  firstName   String?
  lastName    String?
  fullName    String
  email       String?
  phone       String?
  contactType String[]
  profession  String[]
  isUnion     Boolean?
  notes       String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  directingUnits  UnitProduction[] @relation("Director")
  writingUnits    UnitProduction[] @relation("Writer")
  projectContacts ProjectContact[]
  bookings        Booking[]
  assignedTasks   Task[]

  @@index([fullName])
}

enum BookingResourceType {
  PERSON
  LOCATION
  EQUIPMENT
}

enum BookingStatus {
  CONFIRMED
  SOFT_HOLD
  CANCELLED
}

// The flagship entity: links a bookable resource (person, location, or
// equipment) to a project for a date range. Overlapping bookings for the
// same resource across different projects are what conflict detection
// checks for (see lib/conflicts.ts).
model Booking {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  unitProductionId String?
  unitProduction   UnitProduction? @relation(fields: [unitProductionId], references: [id])

  resourceType BookingResourceType

  personId String?
  person   Person? @relation(fields: [personId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])

  roleOnProject String?
  startDate     DateTime
  endDate       DateTime
  status        BookingStatus @default(CONFIRMED)

  // Set when the creator saw a conflict warning and chose to save anyway.
  conflictAcknowledged Boolean @default(false)
  notes                String? @db.Text

  createdById String?
  createdBy   User?   @relation("BookingCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, startDate, endDate])
  @@index([locationId, startDate, endDate])
  @@index([equipmentId, startDate, endDate])
  @@index([projectId])
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETE
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// Mirrors Airtable's Tasks & Checklists table. Drives each project's (and
// unit production's) task progress bar: completed / total.
model Task {
  id         String  @id @default(cuid())
  airtableId String? @unique

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  unitProductionId String?
  unitProduction   UnitProduction? @relation(fields: [unitProductionId], references: [id], onDelete: Cascade)

  title    String
  status   TaskStatus    @default(NOT_STARTED)
  priority TaskPriority?
  category String?

  assignedToId String?
  assignedTo   Person? @relation(fields: [assignedToId], references: [id])

  dueDate DateTime?
  notes   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([unitProductionId])
}

// ---------- Scheduling ----------
//
// The scheduling subsystem separates three concepts that the legacy
// ProductionSchedulePhase table conflated:
//
//   SchedulingRequirement  what a project NEEDS scheduled, and for how long
//   ScheduleVariation      a planning scenario ("what could happen")
//   ScheduleAssignment     when a requirement sits, WITHIN one variation
//
// Production identity always lives in Admin (Project / UnitProduction).
// A unit appearing in three variations is three ScheduleAssignment rows
// pointing at one requirement pointing at one unit — never three copies
// of the episode.

model WorkCalendar {
  id        String  @id @default(cuid())
  name      String
  isDefault Boolean @default(false)

  // Explicit per-weekday flags. The default (Mon–Fri) matches the live
  // data exactly: 298 seeded shoot days, zero of them on a weekend.
  worksMonday    Boolean @default(true)
  worksTuesday   Boolean @default(true)
  worksWednesday Boolean @default(true)
  worksThursday  Boolean @default(true)
  worksFriday    Boolean @default(true)
  worksSaturday  Boolean @default(false)
  worksSunday    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exceptions WorkCalendarException[]
  variations ScheduleVariation[]
}

enum WorkCalendarExceptionKind {
  HOLIDAY
  SHUTDOWN
  BLACKOUT
  WORKDAY_OVERRIDE // force a normally-off day ON (e.g. a Saturday shoot)
  NONWORKDAY_OVERRIDE // force a normally-on day OFF
}

model WorkCalendarException {
  id         String       @id @default(cuid())
  calendarId String
  calendar   WorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  date   DateTime                  @db.Date
  kind   WorkCalendarExceptionKind
  // Required on purpose: overriding a weekend is a deliberate act and the
  // reason ("EOTV Stunts") is what makes it reviewable later.
  reason String

  // Optional narrowing — an override that applies to one project only,
  // rather than shifting the whole company calendar.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([calendarId, date, projectId])
  @@index([calendarId, date])
}

// Catalogue of schedulable event types (Prep, Stunts, Post…). Seeded from
// the distinct legacy `phase` values plus ZGM's standard set. Compound
// legacy values ("Pickups / Sound / Wrap") are preserved verbatim rather
// than split by a migration — splitting is a domain call, made here.
model ProductionEventType {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  // A suggestion surfaced in the UI, never a lock — every requirement's
  // duration is independently editable.
  defaultDurationDays Int?
  sortOrder           Int     @default(0)
  active              Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements SchedulingRequirement[]
}

enum RequirementKind {
  UNIT_PRODUCTION
  PRODUCTION_EVENT
}

enum RequirementStatus {
  DRAFT // defined, not placed in any variation
  SCHEDULED_IN_VARIATION // placed somewhere, but not operational
  ON_MASTER // published to the Master Calendar
  COMPLETE
}

// "This project needs this thing scheduled, for this many production days."
// Discriminated by `kind`: either it points at a UnitProduction (an episode
// or unit) or at a ProductionEventType (Prep, Post, Stunts…).
model SchedulingRequirement {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind RequirementKind

  // Exactly one of the two is set, per `kind` — enforced by a CHECK
  // constraint added in the migration alongside the service layer.
  unitProductionId String?
  unitProduction   UnitProduction?      @relation(fields: [unitProductionId], references: [id], onDelete: Cascade)
  eventTypeId      String?
  eventType        ProductionEventType? @relation(fields: [eventTypeId], references: [id])

  label        String? // optional override, e.g. "Second Unit Stunts"
  durationDays Int // in PRODUCTION days — this is the requirement itself
  status       RequirementStatus @default(DRAFT)
  notes        String?           @db.Text
  sortOrder    Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ScheduleAssignment[]

  // One requirement per unit production. Postgres treats NULLs as distinct,
  // so this does not constrain event-type requirements.
  @@unique([projectId, unitProductionId])
  @@index([projectId, status])
}

enum VariationKind {
  MASTER
  VARIATION
}

enum VariationStatus {
  DRAFT
  UNDER_REVIEW
  ARCHIVED
}

// A planning scenario. The Master Calendar is one of these rows with
// `kind = MASTER`, kept singleton by a partial unique index created in the
// migration, and guarded against deletion in the service layer. It is
// presented as a first-class operational calendar in the UI — never as
// "just another variation".
model ScheduleVariation {
  id          String          @id @default(cuid())
  name        String
  description String?         @db.Text
  kind        VariationKind   @default(VARIATION)
  status      VariationStatus @default(DRAFT)

  // Lineage, for audit only. Assignments still point at Admin entities,
  // never at another variation's copy of a production.
  sourceVariationId String?
  sourceVariation   ScheduleVariation?  @relation("VariationLineage", fields: [sourceVariationId], references: [id], onDelete: SetNull)
  derivedVariations ScheduleVariation[] @relation("VariationLineage")

  workCalendarId String?
  workCalendar   WorkCalendar? @relation(fields: [workCalendarId], references: [id])

  windowStart DateTime? @db.Date
  windowEnd   DateTime? @db.Date

  createdById String?
  createdBy   User?    @relation("VariationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments  ScheduleAssignment[]
  publications MasterPublication[]  @relation("PublishedFrom")

  @@index([kind, status])
}

// Where a requirement sits within one variation. Day-level detail hangs off
// this via ShootDay, so day scheduling works inside a variation without
// needing to be pushed to Master first.
model ScheduleAssignment {
  id String @id @default(cuid())

  variationId String
  variation   ScheduleVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  requirementId String
  requirement   SchedulingRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  // Denormalised for the hottest read path (schedule filtered by project).
  // Always equals requirement.projectId; the service layer keeps it true.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  durationDays Int // production days actually spanned

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  notes      String?   @db.Text

  // Provenance from the legacy backfill — keeps the mapping auditable and
  // makes the old table safe to drop once reconciled.
  legacyPhaseId String? @unique
  airtableId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shootDays ShootDay[]

  // Deliberately NOT unique on (variationId, requirementId): a requirement
  // may be split into blocks — "Prep part 1 / part 2" is real in production.
  @@index([variationId, startDate, endDate])
  @@index([projectId, startDate])
  @@index([requirementId])
}

enum PublicationScope {
  ENTIRE_VARIATION
  SELECTED_PROJECTS
}

// Audit record of every push to Master. Snapshots are kept so history
// survives even when the underlying assignments are later replaced again.
model MasterPublication {
  id String @id @default(cuid())

  sourceVariationId String?
  sourceVariation   ScheduleVariation? @relation("PublishedFrom", fields: [sourceVariationId], references: [id], onDelete: SetNull)

  scope      PublicationScope
  projectIds String[] // populated when scope = SELECTED_PROJECTS

  replacedSnapshot Json?
  appliedSnapshot  Json?

  assignmentsAdded    Int @default(0)
  assignmentsReplaced Int @default(0)
  assignmentsRemoved  Int @default(0)

  publishedById String?
  publishedBy   User?    @relation("PublishedBy", fields: [publishedById], references: [id])
  publishedAt   DateTime @default(now())
  note          String?  @db.Text

  @@index([publishedAt])
}

// ---------- Airtable sync bookkeeping ----------

model SyncLog {
  id               String    @id @default(cuid())
  tableName        String
  direction        String // "pull" | "push"
  status           String // "success" | "error"
  recordsProcessed Int       @default(0)
  message          String?   @db.Text
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
}
